APP_NAME=Manga News Private API
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=text
MANGA_NEWS_BASE_URL=https://www.manga-news.com
USER_AGENT=MangaNewsPrivateAPI/0.1 (+private-selfhosted)
API_TOKEN=
# Réservé à de futures routes admin ; inutilisé par les routes publiques actuelles.
ADMIN_TOKEN=
DB_PATH=/data/cache.sqlite3
REQUEST_TIMEOUT_SECONDS=20
REQUEST_MAX_RETRIES=2
REQUEST_BACKOFF_SECONDS=0.5
# PRAGMA busy_timeout appliqué à SQLite. Utile si plusieurs accès concurrents tapent le même cache.
SQLITE_BUSY_TIMEOUT_MS=5000
# Taille maximale du cache mémoire L1 (entrées positives et négatives) au-dessus de SQLite. 0 = désactiver.
CACHE_MEMORY_ENTRIES=512
CACHE_STALE_GRACE_SECONDS=604800
CACHE_TTL_SEARCH_SECONDS=86400
CACHE_TTL_SERIES_SECONDS=86400
CACHE_TTL_VOLUME_SECONDS=604800
CACHE_TTL_NEWS_GLOBAL_SECONDS=21600
CACHE_TTL_NEWS_SERIES_SECONDS=43200
CACHE_TTL_PLANNING_SECONDS=43200
SEARCH_SCORE_THRESHOLD=60
DEFAULT_LIMIT=10
MAX_LIMIT=50
# Nouveau nom. L'ancien SEARCH_FETCH_CONCURRENCY reste accepté pour compatibilité.
SEARCH_SOURCE_CONCURRENCY=4
# Nouveau nom. L'ancien SEARCH_ENRICH_CONCURRENCY reste accepté pour compatibilité.
SEARCH_ENRICHMENT_CONCURRENCY=4
# Comportements par défaut pour /search et /search/resolve quand les query params sont omis.
SEARCH_DEFAULT_ENRICH=true
SEARCH_DEFAULT_INCLUDE_EDITIONS=true
# true = favorise l’œuvre mère et les mangas principaux quand la requête vise une licence ambiguë.
SEARCH_DEFAULT_PREFER_MAIN_SERIES=true
# false = retire les spin-offs et résultats liés reconnus (mangas ou livres) quand les query params sont omis.
SEARCH_DEFAULT_INCLUDE_RELATED=true
# false = retire romans, essais, guides, artbooks, cookbooks et autres livres dérivés quand les query params sont omis.
SEARCH_DEFAULT_INCLUDE_BOOKS=true
# Comportement par défaut pour /volume quand include_parent_editions est omis. false = route légère par défaut.
VOLUME_DEFAULT_INCLUDE_PARENT_EDITIONS=false
ENABLE_DOCS=true
# Présent dans la config, mais pas exposé comme feature publique aujourd'hui.
DEBUG_CAPTURE_HTML_ON_ERROR=false
DEBUG_HTML_DUMP_DIR=/tmp/manga-news-debug-html
NEGATIVE_CACHE_ENABLED=true
NEGATIVE_CACHE_TTL_SECONDS=120
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_SCOPE=ip_or_token
RATE_LIMIT_INCLUDE_ADMIN=false
RATE_LIMIT_EXEMPT_PATHS=/openapi.json,/docs,/redoc,/health
