APP_NAME=Manga News Private API
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=text
MANGA_NEWS_BASE_URL=https://www.manga-news.com
USER_AGENT=MangaNewsPrivateAPI/0.2 (+private-selfhosted)
API_TOKEN=
DB_PATH=/data/cache.sqlite3

REQUEST_TIMEOUT_SECONDS=20
REQUEST_MAX_RETRIES=2
REQUEST_BACKOFF_SECONDS=0.5
REQUEST_MAX_CONCURRENCY=6

SQLITE_BUSY_TIMEOUT_MS=5000
CACHE_MEMORY_ENTRIES=512
CACHE_STALE_GRACE_SECONDS=604800
CACHE_TTL_SEARCH_SECONDS=86400
CACHE_TTL_SERIES_SECONDS=86400
CACHE_TTL_VOLUME_SECONDS=604800
CACHE_TTL_NEWS_GLOBAL_SECONDS=21600
CACHE_TTL_NEWS_SERIES_SECONDS=43200
CACHE_TTL_PLANNING_SECONDS=43200

SEARCH_SCORE_THRESHOLD=60
DEFAULT_LIMIT=50
MAX_LIMIT=50
SEARCH_SOURCE_CONCURRENCY=4
SEARCH_ENRICHMENT_CONCURRENCY=4
SEARCH_DEFAULT_ENRICH=false
SEARCH_DEFAULT_INCLUDE_EDITIONS=false
SEARCH_DEFAULT_PREFER_MAIN_SERIES=false
SEARCH_DEFAULT_INCLUDE_RELATED=true
SEARCH_DEFAULT_INCLUDE_BOOKS=true
VOLUME_DEFAULT_INCLUDE_PARENT_EDITIONS=false

ENABLE_DOCS=true
DEBUG_CAPTURE_HTML_ON_ERROR=false
DEBUG_HTML_DUMP_DIR=/tmp/manga-news-debug-html
NEGATIVE_CACHE_ENABLED=true
NEGATIVE_CACHE_TTL_SECONDS=120
